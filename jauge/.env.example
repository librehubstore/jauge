DATABASE_URL=postgres://jauge:jauge@localhost:5433/jauge
BETTER_AUTH_SECRET=change-me-32-chars-minimum-random-string
BETTER_AUTH_URL=http://localhost:3000

# Premier administrateur (créé au premier démarrage du worker, idempotent)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-123

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo (compte librehub). Sans clé : les emails sont écrits dans la console (dev).
BREVO_API_KEY=
MAIL_FROM=Jauge <no-reply@librehub.example>

# Allemagne (MTS-K via Tankerkönig) : clé gratuite + zones à couvrir "lat,lon;lat,lon" (rayon 25 km)
TANKERKOENIG_API_KEY=
DE_ZONES=52.52,13.40;48.14,11.58

# Web Push : clés VAPID (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
